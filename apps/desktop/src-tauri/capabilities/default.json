{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the app's windows may call.",
  "windows": ["main", "tray", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "opener:default",
    "dialog:default",
    "clipboard-manager:allow-write-text",
    "autostart:default"
  ]
}
